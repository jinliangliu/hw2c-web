{
  "mcpServers": {
    "hw2c-local": {
      "type": "stdio",
      "command": "__HW2C_PYTHON__",
      "args": ["-m", "hw2c_connector.local"],
      "cwd": "__HW2C_BACKEND__",
      "env": {
        "HW2C_ROOT": "__HW2C_ROOT__",
        "HW2C_BUILD_PYTHON": "__HW2C_BUILD_PYTHON__",
        "HW2C_WORK_ROOT": "__HW2C_WORK_ROOT__",
        "HW2C_ENABLE_FLASH": "__HW2C_ENABLE_FLASH__",
        "HW2C_PYOCD": "__HW2C_PYOCD__",
        "HW2C_PYOCD_PYTHON": "__HW2C_PYOCD_PYTHON__",
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 180000
    }
  }
}
